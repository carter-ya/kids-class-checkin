{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kids-class-checkin",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/api/*", "/invite/*"] },
  "vars": { "CLASS_TIME_ZONE": "Asia/Shanghai" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kids-class-checkin", "migrations_dir": "migrations" }
  ]
}
